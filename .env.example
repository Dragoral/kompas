# Только локальная демонстрация с синтетическими данными; для production см. README.md. Не коммитьте .env.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
MASTER_KEYS=k1:REPLACE_WITH_BASE64_32_BYTE_KEY
DEMO_PASSWORD=CHANGE_ME_RANDOM_DEMO_PASSWORD
CORS_ORIGINS=http://localhost:8081
APP_ENV=development
REQUIRE_MFA=1
WORKERS=4
NOTIFY_PROVIDER=log
WEB_PORT=8081
# Web Push (VAPID): без ключа сервер создаст его в data/vapid.key. При смене ключа подписки браузеров перестают работать.
VAPID_SUBJECT=mailto:admin@example.org
# VAPID_PRIVATE_KEY=<base64url 32 байта>
